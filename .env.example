# LLM Configuration (Default is local Ollama)
LLM_PROVIDER=custom
LLM_MODEL=qwen2.5-coder:1.5b
LLM_SEARCH_ENABLED=true

# Ollama Endpoint Configuration
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Alternative API Keys (Leave blank to use Ollama)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Image Configurations for Dynamic database/API provisioning
FUSEKI_IMAGE=frnzdock/fairgraph-fuseki:latest
API_IMAGE=frnzdock/fairgraph-api:latest
OIDC_JWKS_URL=https://proxy.sram.surf.nl/OIDC/jwks

# DOCKER_SOCKET_PATH=/home/frans/podman.sock

CUSTOM_BASE_URL=
CUSTOM_MODEL=gpt-oss-120b
CUSTOM_API_KEY=

# or https://proxy.sram.surf.nl/.well-known/jwks.json

# OIDC / SRAM Configuration
# Set AUTH_MODE=oidc in docker-compose/podman-compose if you wish to run with OIDC active
# AUTH_MODE=mock for local testing (no OIDC, no authentication, no authorization)
AUTH_MODE=oidc

#OIDC_ISSUER_URL=http://localhost:8000
OIDC_ISSUER_URL=https://proxy.sram.surf.nl
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://fairgraph.nl/login
OIDC_SCOPE=openid profile email eduperson_entitlement
OIDC_USERNAME_CLAIM=preferred_username
OIDC_ROLE_CLAIM=role
OIDC_GROUPS_CLAIM=eduperson_entitlement
OIDC_AUDIENCE=
OIDC_JWKS_URL=https://proxy.sram.surf.nl/OIDC/jwks

# INTERNAL/INITIAL PASSWORDS

INTERNAL_API_SECRET=
# openssl rand -hex 32
INITIAL_ADMIN_PASSWORD=

### SEARCH OTIONS
FACET_MAX_DEPTH=5
RESULT_CACHE_TTL=86400
